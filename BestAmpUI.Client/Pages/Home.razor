@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient HTTP
@using System.Net.Http.Json
@using System.Text.Json
@using BestAmpUI.Client.Models

<main>
<header>
    <h1>BestAmp Control Interface</h1>

    <div class="control-row">
        @foreach (DialKnob dial in DialKnobs)
        {
            <div class="control-item">
                <span class="control-label">@dial.Label</span>
                <span class="control-input">
                    <img src="@DIAL_ICON" alt="Dial" />
                    @if (dial.Label == "Voice")
                    {
                        <select id="@dial.Label" 
                            disabled="@(!Initialized)" @bind=dial.Value @bind:after="SendDials"
                        >
                            @foreach (var voice in Voices)
                            {
                                <option value=@voice.Key>@voice.Value</option>
                            }
                        </select>
                    } else
                    {
                        <input id="@dial.Label" type="number" step="any" min=0 max=10
                            disabled="@(!Initialized)" @bind="dial.Value" @bind:after="SendDials" 
                        />  
                    }
                </span>
            </div>
        }

        <div class="control-item">
            <span class="control-label">Settings</span>
            <span class="control-input">
                <img src="@SETTINGS_ICON" alt="Settings" />
                @{ string buttonLabel = SettingsOpen ? "Save" : "Open"; }
                <input type="button" 
                    disabled="@(!Initialized)" @onclick="ToggleSettings" value=@buttonLabel
                />
            </span>
        </div>
    </div>

    @if (SettingsOpen)
    {
        <section class="settings-panel">
            <div class="settings-row extend-to-end">
                <label for="hostApi">Host API</label>
                <select id="hostApi" 
                    disabled="@(!Initialized)" @bind="Settings.HostApi" @bind:after="OnHostApiChanged"
                >
                    @foreach (var hostApi in HostApis)
                    {
                        <option value=@hostApi.Key>@hostApi.Value.Name</option>
                    }
                </select>
            </div>
            <div class="settings-row">
                <label for="deviceIn">In Device</label>
                <select id="deviceIn" 
                    disabled="@(!Initialized)" @bind="Settings.DeviceIn" @bind:after="SavePreferences"
                >
                    @foreach (var device in Devices)
                    {
                        <option value=@device.Key>@device.Value.Name</option>
                    }
                </select>
                <label for="channelIn">In Channel Number</label>
                <input id="channelIn" type="number" min=0 max=@MaxChannelIn() 
                    disabled="@(!Initialized)" @bind="Settings.ChannelIn" @bind:after="SavePreferences" 
                />
            </div>
            <div class="settings-row">
                <label for="deviceOut">Out device</label>
                <select id="deviceOut" 
                    disabled="@(!Initialized)" @bind="Settings.DeviceOut" @bind:after="SavePreferences"
                >
                    @foreach (var device in Devices)
                    {
                        <option value=@device.Key>@device.Value.Name</option>
                    }
                </select>
                <label for="channelOut">Out Channel Number</label>
                <input id="channelOut" type="number" min=0 max=@MaxChannelOut() 
                    disabled="@(!Initialized)" @bind="Settings.ChannelOut" @bind:after="SavePreferences"
                />
            </div>
            <div class="settings-row extend-to-end">
                <label for="sampleRate">Sample Rate (in Hz)</label>
                <input id="sampleRate" type="number" 
                    disabled="@(!Initialized)" @bind="Settings.SampleRate" @bind:after="SavePreferences"
                />
            </div>
            <div class="settings-row extend-to-end">
                
                <label for="framesPerBuffer">Frames per buffer</label>
                <select id="framesPerBuffer" 
                    disabled="@(!Initialized)" @bind="Settings.FramesPerBuffer" @bind:after="SavePreferences"
                >
                    <option value=0>0</option>
                    @for (int exp = 1; exp <= 9; exp++)
                    {
                        <option>@Math.Pow(2, exp)</option>
                    }
                </select>
            </div>
        </section>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p role="alert">@ErrorMessage</p>
    }
</header>

<body class="profile-select">
    <h2>Profile</h2>
    <div>
        <select id="currentProfile" 
            disabled="@(!Initialized)" @bind="CurrentProfile" @bind:after="OnProfileChanged"
        >
            @foreach (var profile in Profiles)
            {
                <option value=@profile.Key>@profile.Key</option>
            }
        </select>
        <input id="profileName" type="text" maxlength="32" size="16" @bind="ProfileNameInput"/>
        <button @onclick="OnSaveProfile">Save</button>
    </div>
</body>

</main>

@code {
    /// <summary>
    /// This object is to be injected into the JS Runtime so it can call the functions here
    /// </summary>
    private DotNetObjectReference<Home>? callback;

    // File Paths
    private const string DIAL_ICON = "dial.png";
    private const string SETTINGS_ICON = "amp2.png";

    // Function Names From JS Environment
    private const string JSFUNC_CONNECT = "tcpClient.connect";
    private const string JSFUNC_SEND = "tcpClient.send";
    private const string JSFUNC_CLOSE = "tcpClient.close";

    // Endpoints
    private const string BRIDGE_ENDPOINT = "ws://127.0.0.1:7081/backend";
    private const string PREFS_ENDPOINT = "http://127.0.0.1:7081/prefs";

    // Hardcoded Data
    private const int DEFAULT_FRAMES_PER_BUFFER = 32;
    private const int DEFAULT_SAMPLE_FORMAT = 0;
    private static readonly DialKnob[] DialKnobs =
    [
        new("Voice"),
        new("Gain"),
        new("Volume"),
        new("Bass"),
        new("Treble")
    ];
    private static Dictionary<int, Func<byte[], Response>> OpcodeToResponse = new()
    {
        { UpdatePrefsResponse.OPCODE, (msg) => new UpdatePrefsResponse(msg) },
        { HostApisResponse.OPCODE, (msg) => new HostApisResponse(msg) },
        { DeviceIdsResponse.OPCODE, (msg) => new DeviceIdsResponse(msg) },
        { UpdateAmpValuesResponse.OPCODE, (msg) => new UpdateAmpValuesResponse(msg) },
        { VoicesResponse.OPCODE, (msg) => new VoicesResponse(msg) },
        { OkResponse.OPCODE, (msg) => new OkResponse(msg) },
        { BadResponse.OPCODE, (msg) => new BadResponse(msg) },
    };

    // Properties
    private UpdateAmpValuesRequest Dials { get; set; } = new();
    private UpdatePrefsRequest Settings { get; set; } = new();
    private UserPrefs? UserPrefs { get; set; }
    private Dictionary<int, string> Voices { get; set; } = [];
    private Dictionary<int, HostApiInfo> HostApis { get; set; } = [];
    private Dictionary<int, DeviceInfo> Devices { get; set; } = [];
    private string CurrentProfile { get; set; } = UserPrefs.DEFAULT;
    private Dictionary<string, UpdateAmpValuesRequest> Profiles { get; set; } = new ()
    {
        { UserPrefs.DEFAULT, new UpdateAmpValuesRequest() }
    };
    private string ProfileNameInput { get; set; } = UserPrefs.DEFAULT;

    /// <summary>
    /// Used to display any errors
    /// </summary>
    private string? ErrorMessage;

    /// <summary>
    /// Controls if the settings section is being shown
    /// </summary>
    private bool SettingsOpen { get; set; }

    /// <summary>
    /// True if all necessary settings data is retrieved
    /// </summary> 
    private bool Initialized { get; set; } 

    /// <summary>
    /// True if BestAmp already provided a default host API
    /// </summary>
    private bool ReceivedDefaultHostApi { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // connect to bridge
            callback = DotNetObjectReference.Create(this);
            _ = JS.InvokeVoidAsync(JSFUNC_CONNECT, BRIDGE_ENDPOINT, callback);

            StateHasChanged(); 
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync(JSFUNC_CLOSE);
        callback?.Dispose();
    }

    [JSInvokable]
    public async Task OnBridgeConnected()
    {
        LoadDials();
        await LoadPreferences();
        await RequestVoices();
        await RequestDefaultHostApi();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTcpMessage(byte[] message)
    {   
        int opcode = Response.OpcodeFromMessage(message);

        Response response;
        try
        {
            response = OpcodeToResponse[opcode](message);
            await HandleResponse(response, opcode);
        } 
        catch (KeyNotFoundException)
        {
            Console.WriteLine($"Unknown opcode {opcode}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleResponse(Response response, int opcode)
    {
        Console.WriteLine($"Received message with opcode {opcode}");
        switch (opcode)
        {
            case HostApisResponse.OPCODE:
                Dictionary<int, HostApiInfo> availableApis = ((HostApisResponse)response).HostApis;

                if (availableApis.Count == 0)
                {
                    ErrorMessage = "BestAmp did not detect any host APIs.";
                    break;
                }

                HostApis = availableApis;

                if (!ReceivedDefaultHostApi)
                {
                    ReceivedDefaultHostApi = true;
                    Settings.HostApi = HostApis.Keys.First();
                    await RequestHostApis();
                    break;
                }

                int? _savedHostApi = UserPrefs?.Settings?.HostApi;
                if (_savedHostApi is int savedHostApi && HostApis.ContainsKey(savedHostApi))
                {
                    Settings.HostApi = savedHostApi;
                }
                else if (!HostApis.ContainsKey(Settings.HostApi))
                {
                    ReceivedDefaultHostApi = false;
                    Initialized = false;
                    await RequestDefaultHostApi();
                    break;    
                }

                if (!Initialized)
                {
                    await RequestDeviceIds();
                }

                break;

            case DeviceIdsResponse.OPCODE:
                Dictionary<int, DeviceInfo> availableDevices = ((DeviceIdsResponse)response).Devices;

                Devices = availableDevices;

                HostApiInfo apiInfo;
                try
                {
                    apiInfo = HostApis[Settings.HostApi];
                }
                catch (KeyNotFoundException)
                {
                    ErrorMessage = "Selected Host API became unavailable mid operation.";
                    break;
                }

                Settings.DeviceIn = apiInfo.DefaultInDevice;
                Settings.DeviceOut = apiInfo.DefaultOutDevice;
                Settings.ChannelIn = MaxChannelIn();
                Settings.ChannelOut = MaxChannelOut();
                Settings.SampleRate = Devices[Settings.DeviceIn].SampleRate;
                Settings.FramesPerBuffer = DEFAULT_FRAMES_PER_BUFFER; // TODO: find a good default
                Settings.SampleFormat = DEFAULT_SAMPLE_FORMAT; // TODO: still confused on what this is

                if (UserPrefs?.Settings is UpdatePrefsRequest saved)
                {
                    Settings.DeviceIn = Devices.ContainsKey(saved.DeviceIn) ? saved.DeviceIn : Settings.DeviceIn;
                    Settings.DeviceOut = Devices.ContainsKey(saved.DeviceOut) ? saved.DeviceOut : Settings.DeviceOut;
                    Settings.ChannelIn = saved.ChannelIn <= MaxChannelIn() ? saved.ChannelIn : Settings.ChannelIn;
                    Settings.ChannelOut = saved.ChannelOut <= MaxChannelOut() ? saved.ChannelOut : Settings.ChannelOut;
                    Settings.SampleRate = saved.DeviceIn == Settings.DeviceIn ? saved.SampleRate : Settings.SampleRate;
                    Settings.FramesPerBuffer = saved.FramesPerBuffer >= 0 ? saved.FramesPerBuffer : Settings.FramesPerBuffer;
                    @* Settings.SampleFormat = saved.SampleFormat; *@
                    // TODO: still confused on what this is
                }

                Initialized = true;
                await SavePreferences();
                break;

            case VoicesResponse.OPCODE:
                Voices = ((VoicesResponse)response).VoicesIdToName;
                break;

            case UpdatePrefsResponse.OPCODE:
                Console.WriteLine(((UpdatePrefsResponse)response).success ? 
                    "Updated settings successfully!" : 
                    "Failed to update amp settings!"
                );
                break;

            case OkResponse.OPCODE:
                break;

            case BadResponse.OPCODE:
                Console.WriteLine("Server replied with generic error.");
                break;

            case UpdateAmpValuesResponse.OPCODE:
                Console.WriteLine("Updated amp values successfully!");
                break;

            default:
                Console.WriteLine($"Handler for opcode {opcode} not found.");
                break;
        }
    }

    private async Task OnHostApiChanged()
    {
        if (!Initialized)
        {
            return;
        }

        Settings.DeviceIn = -1;
        Settings.DeviceOut = -1;
        await RequestDeviceIds();
    }

    private async Task OnProfileChanged()
    {
        ProfileNameInput = CurrentProfile;


        Dials = Profiles[CurrentProfile];
        LoadDials();
        Dials = new ();
        CaptureDials();

        await SavePreferences(saveProfiles: true);
    }

    private async Task OnSaveProfile()
    {
        Dials = new();
        CaptureDials();

        Profiles[ProfileNameInput] = Dials;
        CurrentProfile = ProfileNameInput;

        await OnProfileChanged();
    }

    private async Task ToggleSettings()
    {
        if (SettingsOpen)
        {
            await SendSettings();
            SettingsOpen = false;
            return;
        }

        SettingsOpen = true;
    }

    private int MaxChannelIn() 
    {
        try
        {
            return Devices[Settings.DeviceIn].MaxInChannel;
        } 
        catch (KeyNotFoundException)
        {
            return 0;   
        }
    }

    private int MaxChannelOut()
    {
        try
        {
            return Devices[Settings.DeviceOut].MaxOutChannel;
        } 
        catch (KeyNotFoundException)
        {
            return 0;   
        }
    }

    private void CaptureDials()
    {
        Dials.Voice = DialKnobs[0].Value;
        Dials.Gain = DialKnobs[1].Value;
        Dials.Volume = DialKnobs[2].Value;
        Dials.Bass = DialKnobs[3].Value;
        Dials.Treble = DialKnobs[4].Value;
    }

    private void LoadDials()
    {
        DialKnobs[0].Value = Dials.Voice;
        DialKnobs[1].Value = Dials.Gain;
        DialKnobs[2].Value = Dials.Volume;
        DialKnobs[3].Value = Dials.Bass;
        DialKnobs[4].Value = Dials.Treble;
    }

    private async Task SendDials()
    {
        CaptureDials();
        await SavePreferences();
        await JS.InvokeVoidAsync(JSFUNC_SEND, Dials.BuildMsg());
    }

    private async Task SendSettings()
    {
        await SavePreferences();
        await JS.InvokeVoidAsync(JSFUNC_SEND, Settings.BuildMsg());
    }

    private async Task LoadPreferences()
    {
        using HttpResponseMessage httpMsg = await HTTP.GetAsync(PREFS_ENDPOINT);
        if (httpMsg.StatusCode == System.Net.HttpStatusCode.NotFound || !httpMsg.IsSuccessStatusCode)
        {
            Console.WriteLine("User preferences unavailable.");
            UserPrefs = null;
            return;
        }

        try
        {
            UserPrefs = await httpMsg.Content.ReadFromJsonAsync<UserPrefs>();
        }
        catch (JsonException err)
        {
            ErrorMessage = "Problem parsing user preferences"; 
            Console.Error.WriteLine(err.Message);
            return;
        }

        try
        {
            Dials = UserPrefs!.Profiles[UserPrefs.CurrentProfile];
        }
        catch (KeyNotFoundException)
        {
            Dials = UserPrefs!.Profiles[UserPrefs.DEFAULT];
        }

        LoadDials();
        Dials = new(); // avoid keeping the references from UserPrefs
        CaptureDials();
    }

    private async Task SavePreferences() => await SavePreferences(false);
    private async Task SavePreferences(bool saveProfiles)
    {
        try
        {
            UserPrefs preferences = new()
            {
                Settings = Settings,
                CurrentProfile = CurrentProfile,
                Profiles = saveProfiles ? Profiles : UserPrefs?.Profiles ?? new(), 
            };

            UserPrefs = preferences;

            using HttpResponseMessage response = await HTTP.PutAsJsonAsync(PREFS_ENDPOINT, preferences);
            response.EnsureSuccessStatusCode(); // may throw HttpRequestException
            ErrorMessage = null;
        }
        catch (HttpRequestException err)
        {
            ErrorMessage = $"Preferences could not be saved.";
            Console.WriteLine(err.Message); 
        }
        catch (JsonException err)
        {
            ErrorMessage = $"Preferences could not be saved.";
            Console.WriteLine(err.Message);
        }
    }

    private async Task RequestDefaultHostApi()
    {
        DefaultHostApiRequest request = new();
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private async Task RequestDeviceIds()
    {
        DeviceIdsRequest request = new();
        request.HostApi = Settings.HostApi;
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private async Task RequestHostApis()
    {
        HostApisRequest request = new();
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private async Task RequestVoices()
    {
        VoicesRequest request = new();
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private class DialKnob(string label)
    {
        public string Label { get; } = label;
        public int Value { get; set; }
    }
}
