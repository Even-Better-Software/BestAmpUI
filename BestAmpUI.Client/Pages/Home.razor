@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@using BestAmpUI.Client.Models

<main>
    <header>
        <h1>BestAmp Control Interface</h1>

        <div class="control-row">
            @foreach (DialKnob dial in DialKnobs)
            {
                <div class="control-item">
                    <span class="control-label">@dial.Label</span>
                    <span class="control-input">
                        <img src="@DIAL_ICON" alt="Dial" />
                        <input type="number" step="any" @bind="dial.Value" @bind:after="SendDials" />
                    </span>
                </div>
            }

            <div class="control-item">
                <span class="control-label">Settings</span>
                <span class="control-input">
                    <img src="@SETTINGS_ICON" alt="Settings" />
                    @{string buttonLabel = SettingsOpen ? "Save" : "Open";}
                    <input type="button" @onclick="ToggleSettings" value=@buttonLabel>
                        @if (SettingsOpen) {<span>v</span>} else {<span>^</span>}
                    </input>
                </span>
            </div>
        </div>

        @if (SettingsOpen)
        {
            <section class="settings-panel">
                <div class="settings-row extend-to-end">
                    <label for="hostApi">Host API</label>
                    <select id="hostApi" @bind=HostApiSelection>
                        @foreach (var hostApi in HostApis)
                        {
                            <option value=@hostApi.Key>@hostApi.Value.Name</option>
                        }
                    </select>
                </div>
                <div class="settings-row">
                    <label for="deviceIn">In Device</label>
                    <select id="deviceIn" @bind="Settings.DeviceIn">
                        @foreach (var device in Devices)
                        {
                            <option value=@device.Key>@device.Value.Name</option>
                        }
                    </select>
                    <label for="channelIn">In Channel Number</label>
                    <input id="channelIn" type="number" min=0 max=@MaxChannelIn() @bind="Settings.ChannelIn" />
                </div>
                <div class="settings-row">
                    <label for="deviceOut">Out device</label>
                    <select id="deviceOut" @bind="Settings.DeviceOut">
                        @foreach (var device in Devices)
                        {
                            <option value=@device.Key>@device.Value.Name</option>
                        }
                    </select>
                    <label for="channelOut">Out Channel Number</label>
                    <input id="channelOut" type="number" min=0 max=@MaxChannelOut() @bind="Settings.ChannelOut" />
                </div>
                <div class="settings-row extend-to-end">
                    <label for="sampleRate">Sample Rate (in Hz)</label>
                    <input id="sampleRate" type="number" @bind="Settings.SampleRate" />
                </div>
                <div class="settings-row extend-to-end">
                    
                    <label for="framesPerBuffer">Frames per buffer</label>
                    <select id="framesPerBuffer" @bind="Settings.FramesPerBuffer">
                        <option value=0>0</option>
                        @for (int exp = 1; exp <= 9; exp++)
                        {
                            <option>@Math.Pow(2, exp)</option>
                        }
                    </select>
                </div>
            </section>
        }
    </header>

    <section class="amplifier-workspace" aria-label="Amplifier workspace"></section>
</main>

<style>
    main {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    header {
        padding: 1rem 1.5rem;
    }

    h1 {
        margin: 0 0 1rem;
        text-align: center;
    }

    .control-row {
        display: flex;
        align-items: end;
        justify-content: center;
        gap: clamp(0.5rem, 3vw, 2rem);
    }

    .control-item {
        display: flex;
        width: min(14vw, 7rem);
        min-width: 3.5rem;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
    }

    .control-label {
        font-weight: 600;
    }

    .control-input {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
    }

    .control-input img {
        width: min(100%, 6rem);
    }

    .control-input input {
        box-sizing: border-box;
        width: 100%;
    }

    .settings-panel {
        display: grid;
        max-width: 60rem;
        margin: 1.25rem auto 0;
        gap: 0.6rem;
    }

    .settings-row {
        display: grid;
        grid-template-columns: minmax(9rem, 1fr) minmax(10rem, 2fr) minmax(9rem, 1fr) minmax(10rem, 1fr);
        align-items: center;
        gap: 0.75rem;
        text-align: end;
    }

    .settings-row select, .settings-row input {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }

    .extend-to-end input, .extend-to-end select {
        grid-column: 2 / -1;
    }
</style>

@code {
    /// <summary>
    /// This object is to be injected into the JS Runtime so it can call the functions here
    /// </summary>
    private DotNetObjectReference<Home>? callback;

    // File Paths
    private const string DIAL_ICON = "dial.png";
    private const string SETTINGS_ICON = "amp2.png";

    // Function Names From JS Environment
    private const string JSFUNC_CONNECT = "tcpClient.connect";
    private const string JSFUNC_SEND = "tcpClient.send";
    private const string JSFUNC_CLOSE = "tcpClient.close";

    // Endpoints
    private const string BRIDGE_ENDPOINT = "ws://127.0.0.1:7081/backend";

    // Hardcoded Data
    private static readonly DialKnob[] DialKnobs =
    [
        new("Voice"),
        new("Gain"),
        new("Volume"),
        new("Bass"),
        new("Treble")
    ];

    private static Dictionary<int, Func<byte[], Response>> OpcodeToResponse = new()
    {
            { HostApisResponse.OPCODE, (msg) => new HostApisResponse(msg) },
            { DeviceIdsResponse.OPCODE, (msg) => new DeviceIdsResponse(msg) },
    };

    // Properties
    private DialKnobsData Dials { get; set; } = new();
    private SettingsData Settings { get; set; } = new();
    private int HostApiSelection {
        get => Settings.HostApi;
        set
        {
            Settings.HostApi = value;
            _ = RequestDeviceIds();
            Settings.DeviceIn = -1;
            Settings.DeviceOut = -1;
        }
    }

    private Dictionary<int, HostApiInfo> HostApis = [];
    private Dictionary<int, DeviceInfo> Devices = [];

    /// <summary>
    /// Controls if the settings section is being shown
    /// </summary>
    private bool SettingsOpen { get; set; }

    /// <summary>
    /// True if all necessary settings data is retrieved
    /// </summary>
    private bool Initialized { get; set; } 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // connect to bridge
            callback = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(JSFUNC_CONNECT, BRIDGE_ENDPOINT, callback);

            StateHasChanged(); 
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync(JSFUNC_CLOSE);
        callback?.Dispose();
    }

    [JSInvokable]
    public Task OnBridgeConnected()
    {
        _ = RequestDefaultHostApi();
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnTcpMessage(byte[] message)
    {   
        int opcode = Response.OpcodeFromMessage(message);

        Response response;
        try
        {
            response = OpcodeToResponse[opcode](message);
            HandleResponse(response, opcode);
        } 
        catch (KeyNotFoundException)
        {
            Console.WriteLine($"Unknown opcode {opcode}");
        }

        return InvokeAsync(StateHasChanged);
    }

    private void HandleResponse(Response response, int opcode)
    {
        Console.WriteLine($"Received message with opcode {opcode}");
        switch (opcode)
        {
            case HostApisResponse.OPCODE:
                HostApisResponse apis = (HostApisResponse) response;
                HostApis = apis.HostApis;
                if (!Initialized)
                {
                    HostApiSelection = apis.HostApis.First().Key;
                } 
                foreach (var api in apis.HostApis)
                {
                    Console.WriteLine($"Response: {api.Key}, {api.Value}");
                }
                break;

            case DeviceIdsResponse.OPCODE:
                DeviceIdsResponse devices = (DeviceIdsResponse) response;
                Devices = devices.Devices;
                if (Settings.DeviceIn == -1 || Settings.DeviceOut == -1)
                {
                    Settings.DeviceIn = HostApis[Settings.HostApi].DefaultInDevice;
                    Settings.DeviceOut = HostApis[Settings.HostApi].DefaultOutDevice;

                    // TODO: Is it the sample rate of the in device or out device that we want?
                    Settings.SampleRate = Devices[Settings.DeviceIn].SampleRate;
                }
                if (!Initialized)
                {
                    Console.WriteLine("Initialized");
                    Initialized = true;
                    _ = RequestHostApis();
                }
                foreach (var device in devices.Devices)
                {
                    Console.WriteLine($"Response: {device.Key}, {device.Value.Name}");
                }
                break;

            default:
                Console.WriteLine($"Handler for opcode {opcode} not found.");
                break;   
        }
    }

    private void ToggleSettings()
    {
        if (SettingsOpen)
        {
            SendSettings();
        } 
        SettingsOpen = !SettingsOpen;
    }

    private int MaxChannelIn() 
    {
        try
        {
            return Devices[Settings.DeviceIn].MaxInChannel;
        } 
        catch (KeyNotFoundException)
        {
            return 0;   
        }
    }

    private int MaxChannelOut()
    {
        try
        {
            return Devices[Settings.DeviceOut].MaxInChannel;
        } 
        catch (KeyNotFoundException)
        {
            return 0;   
        }
    }

    private void CaptureDials()
    {
        Dials.Voice = DialKnobs[0].Value;
        Dials.Gain = DialKnobs[1].Value;
        Dials.Volume = DialKnobs[2].Value;
        Dials.Bass = DialKnobs[3].Value;
        Dials.Treble = DialKnobs[4].Value;
    }

    private async Task SendSettings()
    {
        await JS.InvokeVoidAsync(JSFUNC_SEND, Settings.BuildMsg());
    }

    private async Task SendDials()
    {
        CaptureDials();
        await JS.InvokeVoidAsync(JSFUNC_SEND, Dials.BuildMsg());
    }

    private async Task RequestDefaultHostApi()
    {
        DefaultHostApiRequest request = new();
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private async Task RequestDeviceIds()
    {
        DeviceIdsRequest request = new();
        request.HostApi = Settings.HostApi;
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private async Task RequestHostApis()
    {
        HostApisRequest request = new();
        await JS.InvokeVoidAsync(JSFUNC_SEND, request.BuildMsg());
    }

    private class DialKnob(string label)
    {
        public string Label { get; } = label;
        public int Value { get; set; }
    }
}
